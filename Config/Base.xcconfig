// Shared build settings. Defaults to ad-hoc signing so anyone can build.
//
// Ad-hoc signatures change on every build, which makes macOS forget the
// Accessibility / Input Monitoring permissions. To keep them, copy
// Local.xcconfig.example to Local.xcconfig and set your team.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
